# ==============================================================================
# AI Video & Content Team Agent — Configuration Template
# ==============================================================================
# Скопируйте этот файл в .env и заполните ваши ключи:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_your_token_here

# Использовать ли локальный Telegram Bot API сервер (поддерживает файлы до 2000 МБ)
# Если false — используется стандартный облачный api.telegram.org (лимит 20-50 МБ)
USE_LOCAL_BOT_API=false
LOCAL_BOT_API_URL=http://127.0.0.1:8081

# ------------------------------------------------------------------------------
# 2. ElevenLabs API (Word-level Audio Transcription via Scribe)
# ------------------------------------------------------------------------------
# Получите ключ на https://elevenlabs.io -> Profile -> API Keys
# Используется в движке видеомонтажа для пословной разметки таймингов и удаления слов-паразитов
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# ------------------------------------------------------------------------------
# 3. AI / LLM Configuration (Multi-Agent Team Roles)
# ------------------------------------------------------------------------------
# Агрегатор Polza.ai (или прямой OpenAI API / OpenRouter)
# Получите ключ на https://polza.ai или https://platform.openai.com
POLZA_API_KEY=pza_your_polza_api_key_or_openai_key
AI_BASE_URL=https://api.polza.ai/api/v1
CLAUDE_MODEL=anthropic/claude-sonnet-4.5

# Опционально: Google Gemini API Key (для прямых вызовов Google AI)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Video Rendering & Remotion Engine
# ------------------------------------------------------------------------------
# Путь к директории Remotion (по умолчанию: ./remotion)
REMOTION_DIR=./remotion

# Пути к бинарникам FFmpeg и FFprobe (если не в системном PATH)
# macOS (Homebrew): /opt/homebrew/bin/ffmpeg
# Ubuntu/Debian: /usr/bin/ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ------------------------------------------------------------------------------
# 5. Data Directories (Optional Custom Paths)
# ------------------------------------------------------------------------------
# MATERIALS_DIR=./data/materials
# VIDEOS_DIR=./data/videos
# KARUSEL_DIR=./data/carousels

# ------------------------------------------------------------------------------
# 6. White-Label Expert & Brand Profile (Optional Customization)
# ------------------------------------------------------------------------------
EXPERT_NAME="Эксперт"
BRAND_NAME="AI Video Team"
STICKER_BRAND="🔥 ПРАКТИКУМ"
